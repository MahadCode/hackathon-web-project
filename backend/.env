# Copy this file to .env and fill in your own values.
# NEVER commit a real .env file or paste real secrets into chat/version control.

ENVIRONMENT=development

# Async SQLAlchemy connection string
# Replace YOUR_PASSWORD below with the actual password you set for the
# `postgres` user when you installed PostgreSQL. If you created a different
# role/database name, adjust accordingly.
DATABASE_URL=postgresql+asyncpg://postgres:admin123@localhost:5432/hiring_ai

# Randomly generated for you — safe to use as-is for local dev.
JWT_SECRET_KEY=oNpcS8LMLxBhM0dVrugEoChcU4Yyt_YHL0XnRBCOJHsDIN1yoEFHqnpFdTjtd_nBBzDtHDE56Ssu5v3xoasmmQ
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Used by the AI agent layer (ai_agents/config/settings.py)
# Put a NEW key here after rotating the one you pasted earlier — that one
# should be treated as compromised and revoked in Google Cloud Console.
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2